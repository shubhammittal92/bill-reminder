# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# The app sends email if a backend is configured; otherwise it logs the digest.

# --- Option 1: Gmail SMTP (fastest to test) ---
# GMAIL_USER is your Gmail address.
# GMAIL_APP_PASSWORD is a Google "App Password" (16 chars), NOT your login
# password. Create one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled on the account).
# REMINDER_TO defaults to GMAIL_USER (i.e. you email yourself).
GMAIL_USER=
GMAIL_APP_PASSWORD=
REMINDER_TO=

# --- Option 2: AWS SES ---
# SES_FROM must be a verified SES sender identity.
# While SES is in sandbox mode, REMINDER_TO must also be verified.
# SES_FROM=verified-sender@yourdomain.com
# AWS_REGION=us-east-1
